# ══════════════════════════════════════════════════════════════
# FinSight AI Platform — Environment Variables
# ══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# The defaults below work for local docker-compose development.

# ── Database (PostgreSQL) ─────────────────────────────────────
# For local Windows PostgreSQL (default):
DB_URL=jdbc:postgresql://localhost:5432/FinSight
DB_USER=postgres
DB_PASS=FinSight@2026

# For Docker Compose setup:
# DB_URL=jdbc:postgresql://localhost:5432/fintech
# DB_USER=fintech
# DB_PASS=fintech

# ── JWT Authentication ────────────────────────────────────────
# IMPORTANT: Change this in production!
JWT_SECRET=FinSight-Dev-Secret-Key-2026-Must-Be-At-Least-256-Bits-Long!!
JWT_EXPIRATION=86400000

# ── AI Service ────────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:9000

# ── Frontend ──────────────────────────────────────────────────
VITE_API_URL=http://localhost:8080/api
